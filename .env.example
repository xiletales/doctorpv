# Copied to .env with fresh secrets by scripts/ensure-env.mjs
DATABASE_URL="file:./data/sunpulse.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"
GATEWAY_KEY_SECRET="change-me"
NEXT_PUBLIC_DEMO_MODE="true"
# locked = waktu simulasi dikunci di SIM_CLOCK_LOCK_AT WIB; real = jam sebenarnya
SIM_CLOCK_MODE="locked"
SIM_CLOCK_LOCK_AT="10:15"
# Koordinat placeholder, ganti dengan lokasi klaster sebenarnya lalu jalankan npm run seed
NEXT_PUBLIC_MAP_CENTER_LAT="-6.2000"
NEXT_PUBLIC_MAP_CENTER_LNG="106.8166"
NEXT_PUBLIC_MAP_ZOOM="18"
# Rp/kWh dan kgCO2/kWh, keduanya estimasi yang dapat diubah
PLN_TARIFF_RP="1444.70"
GRID_EMISSION_FACTOR="0.87"
