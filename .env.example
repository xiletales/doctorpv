# Copied to .env by scripts/ensure-env.mjs, which fills in only NEXTAUTH_SECRET and GATEWAY_KEY_SECRET.
# Never commit real values. Copy the database URLs from Connect in the Supabase dashboard,
# and percent-encode special characters in the password.

# Transaction pooler, port 6543: application runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler, port 5432: prisma db push and seed. Not the db.<ref>.supabase.co host, which is IPv6-only.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Supabase CA certificate, from Database settings > SSL Configuration in the dashboard
DATABASE_CA_CERT_FILE="supabase-ca.crt"

# Used only by npm run db:verify-rls
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"
GATEWAY_KEY_SECRET="change-me"
NEXT_PUBLIC_DEMO_MODE="true"
# locked = waktu simulasi dikunci di SIM_CLOCK_LOCK_AT WIB; real = jam sebenarnya
SIM_CLOCK_MODE="locked"
SIM_CLOCK_LOCK_AT="10:15"
# Perkiraan pusat Kelurahan Panularan, Surakarta. Posisi rumah tetap hasil generator, bukan survei.
NEXT_PUBLIC_MAP_CENTER_LAT="-7.5741"
NEXT_PUBLIC_MAP_CENTER_LNG="110.8124"
NEXT_PUBLIC_MAP_ZOOM="17.2"
# Rp/kWh dan kgCO2/kWh, keduanya estimasi yang dapat diubah
PLN_TARIFF_RP="1444.70"
GRID_EMISSION_FACTOR="0.87"
